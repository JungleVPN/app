{
  "name": "@jungle/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js --watch",
    "dev:spa": "vite",
    "build": "tsc -b && vite build --outDir dist/client",
    "build:docker": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "typecheck": "tsc -b",
    "start": "node server.js",
    "preview": "vite preview",
    "lint": "biome check ./src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@heroui/react": "^3.0.3",
    "@heroui/styles": "^3.0.3",
    "@remnawave/subscription-page-types": "^0.4.0",
    "@supabase/supabase-js": "^2.103.3",
    "@tabler/icons-react": "^3.31.0",
    "@workspace/core": "workspace:*",
    "@workspace/types": "workspace:*",
    "axios": "1.12.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lottie-react": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.0.0",
    "react-router": "^7.14.1",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "sirv": "^3.0.1",
    "ufo": "^1.6.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^20",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.4.0",
    "@workspace/shared-config": "workspace:*",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5",
    "vite": "^6.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.2"
  }
}
